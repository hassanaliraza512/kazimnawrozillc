# Local SQLite store - no Supabase required
# The database is created automatically at data/kazim-nawrozi.db

# Admin login
ADMIN_EMAIL=admin@kazimnawrozi.com
ADMIN_PASSWORD=change-this-password
ADMIN_SESSION_SECRET=change-this-session-secret

# Public site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional SMTP email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional Twilio WhatsApp notifications
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio WhatsApp sender, for example: whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=
