# PostgreSQL database (Neon/Vercel Postgres)
# Use the pooled connection string for the running application.
DATABASE_URL=
# Optional unpooled connection string for the one-time SQLite migration.
DATABASE_URL_UNPOOLED=

# Admin login
# Optional login name for the owner account; defaults to ADMIN_EMAIL.
ADMIN_USERNAME=
ADMIN_EMAIL=admin@kazimnawrozi.com
ADMIN_PASSWORD=change-this-password
ADMIN_SESSION_SECRET=change-this-session-secret

# Public site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional SMTP email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional Twilio WhatsApp notifications
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio WhatsApp sender, for example: whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=
